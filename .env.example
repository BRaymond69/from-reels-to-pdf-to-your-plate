# Choose which free-tier LLM parses the caption/transcript into a recipe.
# "groq"   -> uses GROQ_API_KEY, model llama-3.3-70b-versatile
# "gemini" -> uses GEMINI_API_KEY, model gemini-1.5-flash
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
